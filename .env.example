# PostgreSQL
POSTGRES_DB=sentinel_mail
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me

# Secrets (generate real values before deploying!)
#
# ENCRYPTION_KEY muss ein gueltiger Fernet-Key sein: 32 zufaellige Bytes,
# url-safe base64-codiert (44 Zeichen inkl. abschliessendem "="). Kein
# Freitext, kein selbst ausgedachter String!
#
# Linux/macOS (Python):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Linux/macOS (OpenSSL):
#   openssl rand -base64 32 | tr '+/' '-_'
# Windows (PowerShell):
#   $b=New-Object byte[] 32;[System.Security.Cryptography.RandomNumberGenerator]::Fill($b);([Convert]::ToBase64String($b) -replace '\+','-' -replace '/','_')
ENCRYPTION_KEY=change-me-generate-a-fernet-key
#
# JWT_SECRET ist ein beliebiger zufaelliger String (keine feste Laenge/Format
# noetig), sollte aber ausreichend lang und zufaellig sein.
#
# Linux/macOS (Python):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Linux/macOS (OpenSSL):
#   openssl rand -base64 48
# Windows (PowerShell):
#   $b=New-Object byte[] 48;[System.Security.Cryptography.RandomNumberGenerator]::Fill($b);[Convert]::ToBase64String($b)
JWT_SECRET=change-me-generate-a-random-secret

# Initial admin account (optional - if unset, the setup wizard in the UI creates it on first visit)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Logging
LOG_LEVEL=INFO

# Timezone for action-chain time windows (Zeitsteuerung). IANA name, e.g.
# Europe/Berlin. Invalid values fall back to UTC.
APP_TIMEZONE=UTC

# Fallback poll interval (seconds) used for any account whose own
# "Poll-Intervall" field is left empty in the UI.
DEFAULT_POLL_INTERVAL_SECONDS=60

# Set to false only for local HTTP development without TLS
COOKIE_SECURE=true

# CUPS
CUPS_SERVER_HOST=cups
CUPS_SERVER_PORT=631

# SMTP (used by the "E-Mail senden" action step - leave SMTP_HOST empty to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Web-Server Port
WEB_SERVER_PORT=8000
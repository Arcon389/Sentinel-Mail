# PostgreSQL
POSTGRES_DB=sentinel_mail
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me

# Secrets (generate real values before deploying!)
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-generate-a-fernet-key
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-random-secret

# Initial admin account (optional - if unset, the setup wizard in the UI creates it on first visit)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Logging
LOG_LEVEL=INFO

# Fallback poll interval (seconds) used for any account whose own
# "Poll-Intervall" field is left empty in the UI.
DEFAULT_POLL_INTERVAL_SECONDS=60

# Set to false only for local HTTP development without TLS
COOKIE_SECURE=true

# CUPS
CUPS_SERVER_HOST=cups
CUPS_SERVER_PORT=631

# SMTP (used by the "E-Mail senden" action step - leave SMTP_HOST empty to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Web-Server Port
WEB_SERVER_PORT=8000